[core]
  excludesfile = ~/.gitignore_global
  attributesFile = ~/.gitattributes_global
  autocrlf = input
  editor = nano

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[delta]
  navigate = true
  line-numbers = true
  side-by-side = false
  syntax-theme = GitHub

[interactive]
  diffFilter = delta --color-only

[user]
  # Set these in ~/.gitconfig_local:
  # name = Your Name
  # email = your.email@example.com
  useConfigOnly = true

[commit]
  # Uncomment to enable GPG signing:
  # gpgsign = true

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = false

[fetch]
  prune = true
  pruneTags = true

[init]
  defaultBranch = main

[diff]
  colorMoved = default
  algorithm = histogram

[rerere]
  enabled = true

# === Useful Aliases ===
[alias]
  # Publishing branches
  publish = "!git push origin $(git symbolic-ref --short HEAD) -u"

  # Switch to main/master branch
  main = "!git checkout main > /dev/null 2>&1 || git checkout master"

  # Clean up merged branches
  prune-branches = "!git fetch -p && for branch in $(git for-each-ref --format '%(refname) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {sub(\"refs/heads/\", \"\", $1); print $1}'); do git branch -D \"$branch\"; done"

  # Show patch without pager
  patch = "!git --no-pager diff"

  # Short status
  st = status -sb

  # Better log
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  # Show last commit
  last = log -1 HEAD --stat

  # Undo last commit but keep changes
  undo = reset HEAD~1 --mixed

[color]
  ui = auto

# Allow local customizations in the .gitconfig_local file
[include]
  path = ~/.gitconfig_local
